GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model used by the agents
# GEMINI_MODEL=gemini-3.1-flash-lite
# Optional: request timeout in ms (default 60000)
# GEMINI_TIMEOUT_MS=60000

# Optional: Upstash Redis for server-side API rate limiting.
# Without these, rate limiting falls back to in-memory (per-instance only).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

NEXT_PUBLIC_FB_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FB_AUTH_DOMAIN=your_firebase_auth_domain_here
NEXT_PUBLIC_FB_PROJECT_ID=your_firebase_project_id_here
NEXT_PUBLIC_FB_STORAGE_BUCKET=your_firebase_storage_bucket_here
NEXT_PUBLIC_FB_SENDER_ID=your_firebase_sender_id_here
NEXT_PUBLIC_FB_APP_ID=your_firebase_app_id_here
